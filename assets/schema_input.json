{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/datasync/main/assets/schema_input.json",
    "title": "nf-core/datasync pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "input": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Input path must be provided and cannot contain spaces"
            },
            "output_path": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Output path for rclone copy must be provided and cannot contain spaces"
            },
            "checksum_md5": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.(csv|tsv)$",
                "errorMessage": "Checksum_md5 cannot contain spaces"
            },
            "checksum_sha": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.(csv|tsv)$",
                "errorMessage": "Checksum_sha cannot contain spaces"
            }
        },
        "required": ["sample", "input", "output_path"],
        "anyOf": [{ "required": ["checksum_md5"] }, { "required": ["checksum_sha"] }]
    }
}
